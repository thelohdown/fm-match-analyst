{
  "name": "fm-match-analyst",
  "version": "0.5.0",
  "private": true,
  "description": "Read-only MCP server that lets Claude and Codex analyse live Football Manager matches from FMMatchLens's local API and archives",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
